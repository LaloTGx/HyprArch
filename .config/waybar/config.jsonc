// Este archivo se ubica en /etc/xdg/waybar o en .config/waybar
{
    //General
    "layer": "top",
    "position": "top",
    "spacing": "0px",
    //Modules
    "modules-left": ["group/share","hyprland/workspaces","memory","cpu","image#album-art","mpris","mpd"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray","hyprland/language","group/audioip","group/audioop","group/backlight","bluetooth","group/battery","group/wifi","idle_inhibitor","custom/finder","custom/tune","clock"],
    //Groups
    "group/audioop": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
		"modules": [
            "pulseaudio",
            "pulseaudio#percent"
		]
	},
    "group/audioip": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
		"modules": [
            "pulseaudio#source",
            "pulseaudio#sourcepercent"
		]
	},
    "group/backlight": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
		"modules": [
            "backlight",
            "backlight#percent"
		]
	},
    "group/battery": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
		"modules": [
            "battery",
            "battery#percent"
		]
	},
    "group/wifi": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-left-to-right": false
        },
		"modules": [
            "network",
            "network#essid"
		]
	},
    "group/share": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-power",
            "transition-right-to-left": false
        },
		"modules": [
            "custom/logo",
            "custom/share"
		]
	},
    //hyprland
    "hyprland/window": {
        //"format": "󱙝 {}",
        "format": "{}",
        "separate-outputs": true,
        "max-length": 30,
        "tooltip": false
    },
    "hyprland/workspaces": {
	    "active-only": true,
	    "format": "{id}"
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-es": "ES"
    },
    //Player Music
    "mpd": {
        //"format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        //"format": "{stateIcon} {title} - {artist}",
        "format": "{stateIcon} {title} | {artist}",
        "title-len":20,
        "artist-len": 20,
        "album-len": 0,
        "format-disconnected": "",
        "format-stopped": " ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
        "on": " "
        },
        "random-icons": {
        "off": "<span color=\"#f53c3c\"></span> ",
        "on": " "
        },
        "repeat-icons": {
        "on": " "
        },
        "single-icons": {
        "on": " "
        },
        "state-icons": {
        "paused": "",
        "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)",
        "tooltip": false,
        "on-click": "mpc toggle"
    },
    "mpris": {
	    "format": "{status_icon} {dynamic}",
	    "format-paused": "{status_icon} {dynamic}",
        "tooltip": false,
        "title-len":20,
        "artist-len": 20,
        "album-len": 0,
        "dynamic-order":["title", "artist"],
        "dynamic-separator": " | ",
	    "status-icons": {
		    "playing": "",
		    "paused": ""
	    },
        "ignored-players": ["firefox"]
    },
    "image#album-art": {
        "exec": "~/.config/waybar/scripts/album.sh",
        "size": 22,
        "interval": 5
    },
    //apps backgroud
    "tray": {
        "icon-size": 15,
        "spacing": 10
    },
    //clock
    "clock": {
        "tooltip": true,
        "format": "{:%a %b %d %I:%M %p}",
        //"tooltip-format": "<tt><big>{calendar}</big></tt>",
        "tooltip-format": "<span size='9pt' font='WenQuanYi Zen Hei Mono'>{calendar}</span>",
        "calendar": {
		    "mode"          : "year",
		    "mode-mon-col"  : 3,
		    "weeks-pos"     : "right",
		    "on-scroll"     : 1,
		    "on-click-right": "mode",
		    "format": {
			    "months":     "<span color='#ffead3'><b>{}</b></span>",
			    "days":       "<span color='#ecc6d9'><b>{}</b></span>",
			    "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
			    "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
			    "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
		    }
	    }
    },
    //process
    "cpu": {
        "format": " {usage}",
        "tooltip": false
    },
    //Ram
    "memory": {
        "format": " {percentage}"
    },
    //Storage
    "disk": {
        "interval": 30,
        "format": "󰥠 {used}/{total}",
        "unit": "GB"
    },
    //Bright
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false
    },
    "backlight#percent": {
        "format": "{percent}",
        "tooltip": false
    },
    //batery
    "battery": {
        "states": {
            "good": 80,
            "warning": 40,
            "critical": 20
        },
        "format": "{icon}",
        "format-full": "",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
        "events": {
		    "on-discharging-warning": "notify-send -u normal 'Low Battery'",
		    "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
		    "on-charging-100": "notify-send -u normal 'Battery Full!'",
		    "on-discharging": "notify-send -u normal 'Power Switch' Discharging",
		    "on-charging": "notify-send -u normal 'Power Switch' Charging'"
	    }
    },
    "battery#percent": {
        "format": "{capacity}%",
        "tooltip": false
    },
    //wifi | ethernet
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": " {ifname}",
        "tooltip-format": "{signalStrength}%",
        "format-linked": "{ifname} (No IP) 󱚻",
        "format-disconnected": "󰤮",
        "format-icons": {
            "wifi": [
                "󰤯", // 0–20%
                "󰤟", // 20–40%
                "󰤢", // 40–60%
                "󰤥", // 60–80%
                "󰤨"  // 80–100%
            ]
        }
    },
    "network#essid": {
        "format-wifi": "{essid}",
        "tooltip": false
    },
    //Bluetooth
    "bluetooth": {
	    "format": "",
        "on-click": "blueman-manager",
	    "format-disabled": "󰂲",
	    "format-connected": "󰂱 {num_connections}",
        "tooltip": false,
	    "tooltip-format": "{controller_alias}\t{controller_address}"
    },
    //Audio
    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": " {icon}",
        "format-bluetooth-muted": "  ",
        "format-muted": " ",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "pulseaudio#percent": {
        "format": "{volume}",
        "format-bluetooth": "{volume}",
        "format-bluetooth-muted": "{volume}",
        "format-muted": "{volume}",
        "tooltip":false
    },
    "pulseaudio#source": {
        "format":"{format_source}",
        "format-source": "",
        "format-source-muted": ""
    },
    "pulseaudio#sourcepercent": {
        "format":"{format_source}",
        "format-source": "{volume}",
        "tooltip":false
    },
    //Finder
    "custom/finder": {
        "format": "",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    //tune
    "custom/tune": {
        "format": "󱕂",
        "on-click": "nwg-look",
        "tooltip": false
    },
    //inhibitor
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        },
        "tooltip": true
    },
    //Screen share
    "custom/share": {
        "format": "",
        "on-click": "hyprctl keyword monitor \"HDMI-A-1,preferred,auto,1,mirror,eDP-1\"",
        "tooltip": false
    },
    //Arch logo
    "custom/logo": {
        "format": "󰣇",
        "on-click": "rofi -show window",
        "tooltip": false,
        "tooltip-format": "Arch Linux",
        //"menu": "on-click",
        //"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
        //"menu-actions": {
        //	"shutdown": "shutdown",
        //	"reboot": "reboot",
        //	"suspend": "systemctl suspend",
        //	"hibernate": "systemctl hibernate"
        //}
    }
}
